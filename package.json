{
  "name": "macmic",
  "version": "0.1.0",
  "description": "麦麦 macmic — Beautiful local voice input for macOS and Windows, powered by Qwen3-ASR.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:main": "cross-env NODE_ENV=development electron . --dev",
    "dev:renderer": "cd src && vite",
    "postinstall": "node scripts/install-app-deps.cjs",
    "build:renderer": "cd src && vite build",
    "preview": "cd src && vite preview",
    "test": "node scripts/test-voice-session.cjs && node scripts/test-vocabulary.cjs && node scripts/test-platform.cjs",
    "setup:model": "sh scripts/install-qwen-runtime.sh",
    "build:mac": "pnpm run build:renderer && node scripts/build-local-mac.cjs",
    "check:public": "python3 scripts/check-public-source.py",
    "setup:model:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Setup-Model.ps1",
    "build:win": "pnpm run build:renderer && electron-builder --win nsis --x64 --publish never"
  },
  "keywords": [
    "macos",
    "apple-silicon",
    "dictation",
    "qwen3-asr",
    "mlx",
    "speech-to-text",
    "chinese",
    "windows"
  ],
  "author": {
    "name": "bushushu2333"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "electron": "36.5.0",
    "electron-builder": "^24.6.4",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "node-gyp": "^11.4.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.10",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "asynckit": "^0.4.0",
    "axios": "^1.6.0",
    "better-sqlite3": "11.10.0",
    "bindings": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "combined-stream": "^1.0.8",
    "delayed-stream": "^1.0.0",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.6.2",
    "es-errors": "^1.3.0",
    "es-object-atoms": "^1.1.1",
    "es-set-tostringtag": "^2.1.0",
    "ffmpeg-static": "^5.2.0",
    "file-uri-to-path": "^2.0.0",
    "form-data": "^4.0.4",
    "get-intrinsic": "^1.3.0",
    "lucide-react": "^0.518.0",
    "math-intrinsics": "^1.1.0",
    "mime-db": "^1.54.0",
    "mime-types": "^3.0.1",
    "next-themes": "^0.4.6",
    "osascript": "^1.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn-ui": "^0.9.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tar": "^7.4.3",
    "tw-animate-css": "^1.3.4",
    "unzipper": "^0.12.3"
  },
  "build": {
    "appId": "io.github.bushushu2333.macmic",
    "productName": "麦麦",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*",
      "src/dist/**/*",
      "src/helpers/**/*",
      "src/utils/**/*",
      "assets/**/*",
      "!node_modules/.cache/**/*",
      "!src/node_modules/**/*",
      "qwen_server.py",
      "LICENSE",
      "NOTICE"
    ],
    "asarUnpack": [
      "node_modules/**/*ffmpeg-static*/**/*",
      "node_modules/**/*better-sqlite3*/**/*",
      "node_modules/**/*bindings*/**/*",
      "qwen_server.py"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "minimumSystemVersion": "14.0",
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "麦麦需要麦克风，将你的语音在本机转换成文字。",
        "NSAppleEventsUsageDescription": "麦麦需要将识别结果输入到当前应用。"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "macmic-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "麦麦 macmic",
      "runAfterFinish": true,
      "license": "LICENSE"
    },
    "extraResources": [
      {
        "from": "scripts",
        "to": "setup",
        "filter": [
          "Setup-Model.ps1",
          "requirements-windows.txt",
          "download-windows-model.py"
        ]
      }
    ],
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bushushu2333/macmic.git"
  },
  "homepage": "https://github.com/bushushu2333/macmic",
  "bugs": {
    "url": "https://github.com/bushushu2333/macmic/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.1"
}
